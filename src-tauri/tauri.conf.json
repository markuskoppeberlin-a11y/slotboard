{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Slotboard",
  "version": "0.1.1",
  "identifier": "com.markuskoppe.slotboard",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis", "deb", "appimage"],
    "publisher": "Markus Koppe",
    "copyright": "© 2026 Markus Koppe",
    "category": "Productivity",
    "shortDescription": "10 clipboard slots. ⌘C/⌘V + 1–0.",
    "longDescription": "Slotboard adds ten clipboard slots to the normal clipboard. Copy with ⌘C and tap a digit to store, press ⌘V and a digit to paste (Ctrl on Windows and Linux). Free, open source and offline.",
    "homepage": "https://github.com/markuskoppeberlin-a11y/slotboard",
    "license": "MIT",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-",
      "dmg": {
        "background": "dmg/background.png",
        "windowSize": { "width": 660, "height": 400 },
        "appPosition": { "x": 180, "y": 190 },
        "applicationFolderPosition": { "x": 480, "y": 190 }
      }
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["German", "English"],
        "displayLanguageSelector": false
      }
    },
    "linux": {
      "deb": {
        "depends": ["libxtst6"]
      }
    }
  }
}
